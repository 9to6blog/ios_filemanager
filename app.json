{
  "expo": {
    "name": "MoaFiles",
    "slug": "moa-files",
    "version": "0.2.0",
    "orientation": "default",
    "scheme": "moafiles",
    "platforms": [
      "ios",
      "web"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ninetosix.moafiles",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "모아 파일",
        "CFBundleLocalizations": [
          "ko",
          "en"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "연결한 네트워크 저장소의 파일을 관리하기 위해 로컬 네트워크에 접근합니다.",
        "UISupportsDocumentBrowser": true,
        "NSFaceIDUsageDescription": "Face ID로 모아 파일 앱의 잠금을 해제합니다.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Files",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.item"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          },
          "image": "./assets/icon.png",
          "imageWidth": 100
        }
      ]
    ]
  }
}
